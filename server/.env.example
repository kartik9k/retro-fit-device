# Copy this file to .env and fill in values before running locally without Docker Compose.
# Never commit .env — it is git-ignored.

# PostgreSQL connection string.
# Local (matches docker-compose.yml postgres service defaults):
DATABASE_URL=postgresql://retro:retro@localhost:5432/readings

# Azure (replace with values from infra/azure-setup.sh output):
# DATABASE_URL=postgresql://retro:<password>@retro-fit-pg.postgres.database.azure.com:5432/readings?sslmode=require
