# iOS captive portal headers exceed the 512-byte default
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Skip TLS server cert verification — development only (Mode 3 Azure HTTPS).
# Connection is still encrypted; the server certificate is not authenticated.
# Remove this line when cert pinning is implemented (DEFERRED §11).
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
